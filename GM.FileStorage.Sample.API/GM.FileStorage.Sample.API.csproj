<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          The XML doc file is generated to feed Swagger/OpenAPI, not to enforce documentation.
          CS1591 (missing XML comment for a public member) is suppressed so the sample's request
          models and controllers are not required to carry doc comments on every public member.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <!-- Web API host: Serilog, controllers, versioning, Swagger, mediator, errors, logging, health, secrets. -->
        <PackageReference Include="GM.API" Version="2.0.1" />
        <PackageReference Include="GM.Mediator" Version="2.0.0" />
        <PackageReference Include="Mapster" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GM.FileStorage.Sample.Application\GM.FileStorage.Sample.Application.csproj" />
        <ProjectReference Include="..\GM.FileStorage.Sample.Infrastructure\GM.FileStorage.Sample.Infrastructure.csproj" />
        <ProjectReference Include="..\GM.FileStorage.Sample.Persistence\GM.FileStorage.Sample.Persistence.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- GM.API's Swagger UI serves these from the content root's Assets folder. -->
        <Content Include="Assets\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>
