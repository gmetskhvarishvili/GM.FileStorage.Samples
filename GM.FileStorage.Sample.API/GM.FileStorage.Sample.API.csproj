<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GM.FileStorage" Version="1.1.0" />
        <!-- All three backends are wired; FileStorage:Provider picks which one is active. -->
        <PackageReference Include="GM.FileStorage.Local" Version="1.1.0" />
        <PackageReference Include="GM.FileStorage.S3" Version="1.1.0" />
        <PackageReference Include="GM.FileStorage.AzureBlob" Version="1.1.0" />
    </ItemGroup>

</Project>
