{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/file-storage",
      "PublicBaseUrl": "http://localhost:5000/files"
    }
  }
}
