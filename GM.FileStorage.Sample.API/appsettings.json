{
  "AllowedHosts": "*",
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/file-storage",
      "PublicBaseUrl": "http://localhost:5000/files"
    },
    "S3": {
      "BucketName": "kyc-docs",
      "Region": "eu-central-1",
      "ServiceUrl": "",
      "ForcePathStyle": false,
      "AccessKey": "",
      "SecretKey": ""
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "kyc"
    }
  },
  "SwaggerDocOptions": {
    "Title": "GM FileStorage Sample",
    "Description": "Upload, download, delete and presign files through GM.FileStorage.",
    "Contact": {
      "Name": "Giorgi Metskhvarishvili",
      "Email": "gmetskhvarishvili95@gmail.com",
      "Url": "https://metskhvarishvili.com"
    },
    "License": {
      "Name": "MIT",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "Headers": [
      "Accept-Language"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog",
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.HttpContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithHttpContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} {Level:u3} {Message:lj}{NewLine:1}{Exception:1}"
        }
      }
    ]
  }
}
