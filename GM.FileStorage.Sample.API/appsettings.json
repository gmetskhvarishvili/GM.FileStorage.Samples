{
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 62914560
    }
  },
  "FileStorage": {
    "Provider": "Local",
    "KeyTemplate": "{meta:tenantId}/{date:yyyy}/{date:MM}/{date:dd}/{id}",
    "MaxFileSize": 52428800,
    "AllowedContentTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "image/*",
      "video/*",
      "application/x-msdownload"
    ],
    "VerifyContentType": true,
    "Encryption": {
      "Enabled": true
    },
    "MalwareScanner": {
      "Enabled": false,
      "ClamAV": {
        "Host": "localhost",
        "Port": 3310
      }
    },
    "Local": {
      "RootPath": "C:/Files"
    },
    "S3": {
      "BucketName": "gm-filestorage-sample",
      "Region": "eu-central-1",
      "ServiceUrl": "",
      "ForcePathStyle": false
    },
    "AzureBlob": {
      "ContainerName": "gm-filestorage-sample"
    }
  },
  // GM.API replays a POST that repeats its Idempotency-Key. The key is locked while the first request runs, and an
  // upload can run for minutes, so LockExpiry outlasts it: a retry meanwhile gets 409, never a second upload.
  "Idempotency": {
    "LockExpiry": "00:10:00"
  },
  "SwaggerDocOptions": {
    "Title": "GM FileStorage Sample",
    "Description": "Upload, list, inspect, download, delete and restore files through GM.FileStorage, with a PostgreSQL catalog of every stored file.",
    "Contact": {
      "Name": "Giorgi Metskhvarishvili",
      "Email": "gmetskhvarishvili95@gmail.com",
      "Url": "https://metskhvarishvili.com"
    },
    "License": {
      "Name": "MIT",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "Headers": [
      "Accept-Language",
      "Authorization",
      "X-Correlation-Id",
      "Idempotency-Key",
      "X-User-Id",
      "X-Client-Id",
      "X-Tenant-Id",
      "X-Session-Id",
      "X-Channel-Id",
      "X-Forwarded-For",
      "X-Forwarded-User-Agent"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog",
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.HttpContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithHttpContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} {Level:u3} {Message:lj}{NewLine:1}{Exception:1}"
        }
      }
    ]
  }
}
