{
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 62914560
    }
  },
  "FileStorage": {
    "Provider": "Local",
    "KeyTemplate": "{category}/{shard}/{id}{ext}",
    "MaxFileSize": 52428800,
    "AllowedContentTypes": [ "application/pdf", "image/*", "video/*" ],
    "VerifyContentType": true,
    "Encryption": {
      "Enabled": false
    },
    "Local": {
      "RootPath": "../App_Data/file-storage",
      "PublicBaseUrl": "http://localhost:5140/files"
    },
    "S3": {
      "BucketName": "gm-filestorage-sample",
      "Region": "eu-central-1",
      "ServiceUrl": "",
      "ForcePathStyle": false
    },
    "AzureBlob": {
      "ContainerName": "gm-filestorage-sample"
    }
  },
  "SwaggerDocOptions": {
    "Title": "GM FileStorage Sample",
    "Description": "Upload, list, inspect, download, delete and presign files through GM.FileStorage, with a PostgreSQL catalog of every stored file.",
    "Contact": {
      "Name": "Giorgi Metskhvarishvili",
      "Email": "gmetskhvarishvili95@gmail.com",
      "Url": "https://metskhvarishvili.com"
    },
    "License": {
      "Name": "MIT",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "Headers": [
      "Accept-Language"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog",
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.HttpContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithHttpContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} {Level:u3} {Message:lj}{NewLine:1}{Exception:1}"
        }
      }
    ]
  }
}
