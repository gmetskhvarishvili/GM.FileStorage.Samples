<Project>

  <!--
    Shared build settings for the GM.FileStorage sample solution. The samples are executable
    documentation, so they are held to the same engineering baseline as the packages they
    demonstrate: latest analyzers + code style, with warnings treated as errors.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Sample-wide analyzer relaxations. These are teaching-code conventions, not defects:
        CA1848 - source-generated LoggerMessage delegates are a high-throughput micro-optimization;
                 the sample favours plain structured-template calls for readability.
    -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>

</Project>
