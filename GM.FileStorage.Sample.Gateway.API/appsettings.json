{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 62914560
    }
  },

  "ReverseProxy": {
    "Routes": {
      "files-upload": {
        "ClusterId": "files-api",
        "Match": { "Path": "/api/{version}/files", "Methods": [ "POST" ] },
        "Metadata": { "RateLimitPolicy": "uploads", "RateLimitPartition": "Ip" }
      },
      "files-batch-upload": {
        "ClusterId": "files-api",
        "Match": { "Path": "/api/{version}/files/batch", "Methods": [ "POST" ] },
        "Metadata": { "RateLimitPolicy": "uploads", "RateLimitPartition": "Ip" }
      },
      "files": {
        "ClusterId": "files-api",
        "Match": { "Path": "/api/{version}/files/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip" }
      },
      "files-presigned": {
        "ClusterId": "files-api",
        "Match": { "Path": "/files/{**catch-all}", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip" }
      },
      "files-api-docs": {
        "ClusterId": "files-api",
        "Match": { "Path": "/swagger/{**catch-all}", "Methods": [ "GET" ] }
      }
    },
    "Clusters": {
      "files-api": {
        "Destinations": {
          "primary": { "Address": "https://localhost:7140/" }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  },

  "RateLimiting": {
    "Policies": {
      "uploads": { "Algorithm": "SlidingWindow", "PermitLimit": 30, "Window": "00:01:00" },
      "api": { "Algorithm": "SlidingWindow", "PermitLimit": 300, "Window": "00:01:00" }
    }
  }
}
