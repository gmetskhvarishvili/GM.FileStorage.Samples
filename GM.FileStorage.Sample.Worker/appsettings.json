{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Quartz": "Warning"
    }
  },
  "FileStorage": {
    "Provider": "Local",
    "Encryption": {
      "Enabled": true
    },
    "MalwareScanner": {
      "Enabled": false,
      "ClamAV": {
        "Host": "localhost",
        "Port": 3310
      }
    },
    "Local": {
      "RootPath": "C:/Files"
    },
    "S3": {
      "BucketName": "gm-filestorage-sample",
      "Region": "eu-central-1",
      "ServiceUrl": "",
      "ForcePathStyle": false
    },
    "AzureBlob": {
      "ContainerName": "gm-filestorage-sample"
    },
    "Catalog": {
      "Integrity": {
        "BatchSize": 20
      },
      "Retention": {
        "DeletedFileDays": 30,
        "BatchSize": 100
      }
    }
  }
}
