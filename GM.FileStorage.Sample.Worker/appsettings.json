{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Quartz": "Warning"
    }
  },
  "FileStorage": {
    "Provider": "Local",
    "Encryption": {
      "Enabled": true
    },
    "Local": {
      "RootPath": "../App_Data/file-storage"
    },
    "S3": {
      "BucketName": "gm-filestorage-sample",
      "Region": "eu-central-1",
      "ServiceUrl": "",
      "ForcePathStyle": false
    },
    "AzureBlob": {
      "ContainerName": "gm-filestorage-sample"
    }
  },
  "Integrity": {
    "BatchSize": 20
  },
  "Retention": {
    "DeletedFileDays": 30,
    "BatchSize": 100
  }
}
