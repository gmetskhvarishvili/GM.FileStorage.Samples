meta {
  name: Sign In
  type: http
  seq: 1
}

post {
  url: {{identityGateway}}/connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  username: {{username}}
  password: {{password}}
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
}

script:post-response {
  const body = res.getBody() || {};
  // Every other request sends it as the bearer token.
  bru.setEnvVar("accessToken", body.accessToken ?? body.access_token);
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("issues an access token", function () {
    const body = res.getBody();
    expect(body.accessToken ?? body.access_token).to.be.a("string").and.not.empty;
  });
}

docs {
  Signs in to GM.Identity (GM.Identity.Samples running, its gateway on {{identityGateway}}) as its seeded admin, with
  the password grant, and saves the access token. The files gateway looks the token up in GM.Identity's session
  store and sets the caller from it.
}
