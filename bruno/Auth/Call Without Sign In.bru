meta {
  name: Call Without Sign In
  type: http
  seq: 2
}

get {
  url: {{gateway}}/api/v1/files
  body: none
  auth: none
}

headers {
  Authorization: Bearer not-a-token
}

tests {
  test("returns 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  A token GM.Identity never issued (or one that expired, or none at all): the gateway answers 401 and the API never
  sees the call.
}
