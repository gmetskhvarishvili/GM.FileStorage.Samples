meta {
  name: Get File History
  type: http
  seq: 13
}

get {
  url: {{gateway}}/api/v1/files/{{fileId}}/history?pageSize=50
  body: none
  auth: none
}

params:query {
  pageSize: 50
  ~action: Downloaded
  ~orderBy: occurredAtUtc asc
  ~userId: {{userId}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("lists what happened, newest first, with who did it", function () {
    const actions = res.getBody().map(e => e.action);
    expect(actions[0]).to.equal("Restored");
    expect(actions[actions.length - 1]).to.equal("Uploaded");
    expect(actions).to.include("Downloaded");
    expect(actions).to.include("Deleted");
    expect(res.getBody()[0].userId).to.be.a("string");
  });
}

docs {
  What happened to the file, newest first: uploaded, downloaded, deleted, restored. Each entry has who did it: user,
  client and session from the actor headers, IP, user agent, correlation id. Filter by action, user, client, session,
  IP or when; order by any field (newest first by default); page by number or by key (X-Pagination header).
}
