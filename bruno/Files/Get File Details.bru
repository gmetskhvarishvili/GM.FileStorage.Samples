meta {
  name: Get File Details
  type: http
  seq: 4
}

get {
  url: {{gateway}}/api/v1/files/{{fileId}}?visibility=All
  body: none
  auth: none
}

params:query {
  visibility: All
}

vars:pre-request {
  fileId: e2888118-7116-4fbc-8e4b-c84934c48995
  gateway: https://localhost:7141
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns the file with its tenant and uploader", function () {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("fileId"));
    expect(body.tenantId).to.equal(bru.getEnvVar("tenantId"));
    expect(body.uploadedBy).to.equal(bru.getEnvVar("userId"));
  });
}

docs {
  Add ?visibility=All to see a deleted file.
}
