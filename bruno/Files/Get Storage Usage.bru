meta {
  name: Get Storage Usage
  type: http
  seq: 9
}

get {
  url: {{gateway}}/api/v1/files/usage
  body: none
  auth: none
}

vars:pre-request {
  gateway: https://localhost:7141
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("counts the tenant's files", function () {
    const body = res.getBody();
    expect(body.tenantId).to.equal(bru.getEnvVar("tenantId"));
    expect(body.fileCount).to.be.at.least(1);
    expect(body.usedBytes).to.be.above(0);
  });
}

docs {
  Bytes and files stored for the caller's tenant (deleted ones until purged), against Quotas:BytesPerTenant.
}
