meta {
  name: Upload Files
  type: http
  seq: 2
}

post {
  url: {{gateway}}/api/v1/files/batch
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(C:\Users\gmets\OneDrive\Desktop\Giorgi_Metskhvarishvili_CV.pdf|C:\Users\gmets\OneDrive\Desktop\Giorgi_Metskhvarishvili_CV_Full.pdf) @contentType(multipart/mixed)
}

vars:pre-request {
  gateway: https://localhost:7141
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("stores each file on its own", function () {
    const results = res.getBody();
    expect(results).to.have.lengthOf(2);
    results.forEach(r => expect(r.succeeded, r.error).to.equal(true));
  });
}

docs {
  Up to 20 multipart `files`, each stored as Upload File would; one result per file, in order.
}
