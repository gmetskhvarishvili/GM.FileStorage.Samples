meta {
  name: Get Deleted File Details
  type: http
  seq: 12
}

get {
  url: {{gateway}}/api/v1/files/{{fileId}}?visibility=All
  body: none
  auth: none
}

params:query {
  visibility: All
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("shows it deleted", function () {
    expect(res.getBody().isDeleted).to.equal(true);
  });
}

docs {
  Deleted files are hidden unless visibility includes them.
}
